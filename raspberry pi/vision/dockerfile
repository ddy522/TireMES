# 파이토치(PyTorch)를 포함하는 공식 파이썬 이미지를 기본 이미지로 사용
FROM python:3.9-slim

# 작업 디렉토리를 /app으로 설정
WORKDIR /app

# 필요한 파이썬 패키지들을 먼저 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 모델 파일과 애플리케이션 코드를 복사
COPY tire_model_complete.pth .
COPY vision.py .
COPY test /app/test

# Flask 애플리케이션의 포트 5000을 외부에 노출
EXPOSE 5000

# 컨테이너 시작 시 실행될 명령어
CMD ["python", "vision.py"]